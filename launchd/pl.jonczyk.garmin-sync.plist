<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pl.jonczyk.garmin-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/pawel.jonczyk/private/Training/sync.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/pawel.jonczyk/private/Training</string>
  <!-- codziennie 9:30; jeśli Mac śpi, launchd odpali zadanie po wybudzeniu -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/pawel.jonczyk/Library/Logs/garmin-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/pawel.jonczyk/Library/Logs/garmin-sync.log</string>
</dict>
</plist>
